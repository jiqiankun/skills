{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.openai/refine-photos/recipe.schema.json",
  "title": "Refine Photos Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "analysis", "intent", "global"],
  "properties": {
    "version": {"const": 1},
    "safety_adjusted": {"type": "boolean", "default": false},
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_hierarchy", "observations", "planned_changes", "limitations"],
      "properties": {
        "subject_hierarchy": {"type": "string", "minLength": 1, "maxLength": 500},
        "observations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "maxItems": 30},
        "planned_changes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "maxItems": 30},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "maxItems": 30}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction", "scene", "contains_people", "aesthetic", "color_tendency", "light_tendency", "style_level", "retouch_level", "reference_used", "creative_light"],
      "properties": {
        "interaction": {"enum": ["plan", "direct"]},
        "scene": {"enum": ["portrait-led", "landscape-led", "balanced", "portrait-only", "landscape-only"]},
        "contains_people": {"type": "boolean"},
        "aesthetic": {"enum": ["natural", "documentary", "cinematic", "film-retro", "black-and-white", "palace-splendor", "jiangnan-elegance", "huizhou-rainmist"]},
        "color_tendency": {"enum": ["source-derived", "neutral", "warm-healing", "forest-fresh", "cool-clean", "low-saturation", "vermilion-gold", "qingdai-soft", "ink-low-color"]},
        "light_tendency": {"enum": ["source-derived", "natural-balanced", "airy-soft", "dimensional", "dramatic", "mist-soft"]},
        "style_level": {"type": "integer", "minimum": 1, "maximum": 3},
        "retouch_level": {"type": "integer", "minimum": 1, "maximum": 3},
        "reference_used": {"type": "boolean"},
        "creative_light": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "acknowledged"],
          "properties": {
            "enabled": {"type": "boolean"},
            "acknowledged": {"type": "boolean"}
          }
        }
      }
    },
    "global": {"$ref": "#/$defs/globalAdjustments"},
    "color_ranges": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hue_center", "hue_width"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "hue_center": {"type": "number", "minimum": 0, "maximum": 360},
          "hue_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
          "hue_shift": {"type": "number", "minimum": -30, "maximum": 30, "default": 0},
          "saturation": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
          "luminance": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
          "protect_skin": {"type": "boolean", "default": true}
        }
      }
    },
    "color_balance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shadows": {"$ref": "#/$defs/colorOffset"},
        "midtones": {"$ref": "#/$defs/colorOffset"},
        "highlights": {"$ref": "#/$defs/colorOffset"}
      }
    },
    "monochrome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "channel_mix", "toning_color", "toning_strength"],
      "properties": {
        "enabled": {"type": "boolean"},
        "channel_mix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 2},
            {"type": "number", "minimum": 0, "maximum": 2},
            {"type": "number", "minimum": 0, "maximum": 2}
          ],
          "items": false
        },
        "toning_color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "items": false
        },
        "toning_strength": {"type": "number", "minimum": 0, "maximum": 0.3}
      }
    },
    "local_adjustments": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mask", "adjustments"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "mask": {"$ref": "#/$defs/mask"},
          "adjustments": {"$ref": "#/$defs/localAdjustments"}
        }
      }
    },
    "protected_masks": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "mask"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "role": {"enum": ["identity", "skin", "texture", "textile", "architecture", "foliage", "water", "other"]},
          "mask": {"$ref": "#/$defs/mask"}
        }
      }
    },
    "repairs": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "target", "source", "radius", "evidence", "evidence_confirmed"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "kind": {"enum": ["sensor-dust", "hot-pixel", "confirmed-damage", "transient-blemish"]},
          "target": {"$ref": "#/$defs/point"},
          "source": {"$ref": "#/$defs/point"},
          "radius": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.03},
          "feather": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.4},
          "opacity": {"type": "number", "minimum": 0.25, "maximum": 1, "default": 1},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 300},
          "evidence_confirmed": {"const": true}
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "denoise": {"type": "number", "minimum": 0, "maximum": 0.5, "default": 0},
        "sharpen": {"type": "number", "minimum": 0, "maximum": 0.5, "default": 0},
        "grain": {"type": "number", "minimum": 0, "maximum": 0.3, "default": 0},
        "grain_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647, "default": 0}
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crop": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "items": false
        },
        "rotate_degrees": {"type": "number", "minimum": -3, "maximum": 3, "default": 0},
        "perspective_quad": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"$ref": "#/$defs/point"},
            {"$ref": "#/$defs/point"},
            {"$ref": "#/$defs/point"},
            {"$ref": "#/$defs/point"}
          ],
          "items": false
        },
        "resize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["long_edge", "allow_upscale", "acknowledged"],
          "properties": {
            "long_edge": {"type": "integer", "minimum": 64, "maximum": 30000},
            "allow_upscale": {"type": "boolean"},
            "acknowledged": {"type": "boolean"}
          }
        }
      }
    },
    "creative_effects": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "mask", "adjustments"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "kind": {"enum": ["gradient-light", "glow", "flare", "light-leak", "beam", "haze", "vignette"]},
          "mask": {"$ref": "#/$defs/mask"},
          "adjustments": {"$ref": "#/$defs/creativeAdjustments"}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_highlight_clip_delta": {"type": "number", "minimum": 0, "maximum": 0.05, "default": 0.005},
        "max_shadow_clip_delta": {"type": "number", "minimum": 0, "maximum": 0.05, "default": 0.005},
        "min_texture_ratio": {"type": "number", "minimum": 0.5, "maximum": 1, "default": 0.72},
        "max_skin_hue_shift_degrees": {"type": "number", "minimum": 1, "maximum": 30, "default": 10},
        "max_mask_halo_ratio": {"type": "number", "minimum": 1, "maximum": 5, "default": 2.5},
        "max_extreme_saturation_delta": {"type": "number", "minimum": 0, "maximum": 0.1, "default": 0.01}
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false
    },
    "colorOffset": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"type": "number", "minimum": -0.25, "maximum": 0.25},
        {"type": "number", "minimum": -0.25, "maximum": 0.25},
        {"type": "number", "minimum": -0.25, "maximum": 0.25}
      ],
      "items": false
    },
    "globalAdjustments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure_ev": {"type": "number", "minimum": -2, "maximum": 2, "default": 0},
        "temperature": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "tint": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "contrast": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "highlights": {"type": "number", "minimum": -1, "maximum": 1, "default": 0},
        "shadows": {"type": "number", "minimum": -1, "maximum": 1, "default": 0},
        "whites": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "blacks": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "saturation": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "vibrance": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0}
      }
    },
    "localAdjustments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure_ev": {"type": "number", "minimum": -1, "maximum": 1, "default": 0},
        "temperature": {"type": "number", "minimum": -0.35, "maximum": 0.35, "default": 0},
        "tint": {"type": "number", "minimum": -0.35, "maximum": 0.35, "default": 0},
        "contrast": {"type": "number", "minimum": -0.4, "maximum": 0.4, "default": 0},
        "highlights": {"type": "number", "minimum": -0.75, "maximum": 0.75, "default": 0},
        "shadows": {"type": "number", "minimum": -0.75, "maximum": 0.75, "default": 0},
        "saturation": {"type": "number", "minimum": -0.4, "maximum": 0.4, "default": 0},
        "vibrance": {"type": "number", "minimum": -0.4, "maximum": 0.4, "default": 0},
        "hue_shift": {"type": "number", "minimum": -20, "maximum": 20, "default": 0},
        "luminance": {"type": "number", "minimum": -0.4, "maximum": 0.4, "default": 0},
        "smoothing": {"type": "number", "minimum": 0, "maximum": 0.35, "default": 0},
        "clarity": {"type": "number", "minimum": -0.4, "maximum": 0.4, "default": 0},
        "sharpen": {"type": "number", "minimum": 0, "maximum": 0.4, "default": 0},
        "denoise": {"type": "number", "minimum": 0, "maximum": 0.4, "default": 0}
      }
    },
    "creativeAdjustments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure_ev": {"type": "number", "minimum": -1, "maximum": 1, "default": 0},
        "temperature": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "tint": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "contrast": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "saturation": {"type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0},
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "items": false
        },
        "color_strength": {"type": "number", "minimum": 0, "maximum": 0.5, "default": 0}
      }
    },
    "colorGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue_center", "hue_width"],
      "properties": {
        "hue_center": {"type": "number", "minimum": 0, "maximum": 360},
        "hue_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "saturation_min": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "saturation_max": {"type": "number", "minimum": 0, "maximum": 1, "default": 1},
        "luminance_min": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "luminance_max": {"type": "number", "minimum": 0, "maximum": 1, "default": 1}
      }
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["full", "ellipse", "polygon", "linear-gradient", "radial-gradient"]},
        "center": {"$ref": "#/$defs/point"},
        "radius": {"$ref": "#/$defs/point"},
        "points": {"type": "array", "minItems": 3, "maxItems": 100, "items": {"$ref": "#/$defs/point"}},
        "start": {"$ref": "#/$defs/point"},
        "end": {"$ref": "#/$defs/point"},
        "inner_radius": {"type": "number", "minimum": 0, "maximum": 1},
        "outer_radius": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "feather": {"type": "number", "minimum": 0, "maximum": 0.5, "default": 0.03},
        "invert": {"type": "boolean", "default": false},
        "color_gate": {"$ref": "#/$defs/colorGate"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "ellipse"}}}, "then": {"required": ["center", "radius"]}},
        {"if": {"properties": {"type": {"const": "polygon"}}}, "then": {"required": ["points"]}},
        {"if": {"properties": {"type": {"const": "linear-gradient"}}}, "then": {"required": ["start", "end"]}},
        {"if": {"properties": {"type": {"const": "radial-gradient"}}}, "then": {"required": ["center", "inner_radius", "outer_radius"]}}
      ]
    }
  }
}
